[
  {
    "id": "forms",
    "act": [
      {
        "tool": "browser_type",
        "args": {
          "element": "@ref:Name",
          "text": "Ada"
        }
      },
      {
        "tool": "browser_click",
        "args": {
          "element": "@ref:Submit form"
        }
      }
    ],
    "expect": [
      {
        "tool": "browser_assert",
        "args": {
          "kind": "dom",
          "target": "#out",
          "expected": {
            "text": "hello Ada"
          },
          "timeoutMs": 1500
        }
      }
    ],
    "url": "/fixtures/forms.html",
    "expectSnapshot": [
      {
        "role": "textbox",
        "name": "Name"
      },
      {
        "role": "button",
        "name": "Submit form"
      }
    ]
  },
