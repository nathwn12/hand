  {
    "id": "drag-and-drop",
    "act": [
      {
        "tool": "browser_evaluate",
        "args": {
          "expression": "(() => { const dt=new DataTransfer(); document.getElementById('item').dispatchEvent(new DragEvent('dragstart',{dataTransfer:dt,bubbles:true})); document.getElementById('target').dispatchEvent(new DragEvent('dragover',{dataTransfer:dt,bubbles:true,cancelable:true})); document.getElementById('target').dispatchEvent(new DragEvent('drop',{dataTransfer:dt,bubbles:true,cancelable:true})); })()"
        }
      }
    ],
    "expect": [
      {
        "tool": "browser_assert",
        "args": {
          "kind": "dom",
          "target": "#out",
          "expected": {
            "text": "dropped"
          },
          "timeoutMs": 1500
        }
      }
    ],
    "url": "/fixtures/drag-and-drop.html",
    "expectSnapshot": [
      {
        "role": "button",
        "name": "Reset drag"
      }
    ]
  },
