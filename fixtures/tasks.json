      "cleanup": []
    },
    {
      "id": "t30-trace-har",
      "title": "Trace, HAR and cancel cleanup",
      "requires": [{ "tool": "browser_trace" }],
      "calls": [
        { "tool": "browser_navigate", "args": { "url": "{{origin}}/tasks/main.html?Authorization=bearer-token" } },
        { "tool": "browser_trace", "args": { "dir": "{{tempDir}}/trace", "screenshots": true, "har": true, "redact": ["Authorization"] } },
        { "tool": "browser_trace", "args": { "action": "cancel" } }
      ],
      "expect": { "all": [
        { "call": 1, "path": "payload.files.length", "op": "gte", "value": 1 },
        { "call": 1, "path": "payload.redactions.0.literal", "op": "eq", "value": "Authorization" },
        { "call": 1, "path": "payload.redactions.0.count", "op": "gte", "value": 1 },
        { "call": 1, "path": "payload.redactions.0.marker", "op": "eq", "value": "[REDACTED]" },
        { "call": 2, "path": "payload.ok", "op": "eq", "value": true }
      ] },
      "cleanup": []
    }
  ]
