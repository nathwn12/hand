      "calls": [
        { "tool": "browser_navigate", "args": { "url": "{{origin}}/tasks/main.html" } },
        { "tool": "browser_assert", "args": { "kind": "ax", "target": "role=button[name=\"Act\"]", "expected": { "role": "button", "name": "Act" } } }
      ],
      "expect": { "all": [
        { "call": 1, "path": "payload.verdict", "op": "eq", "value": "pass" }
      ] },
      "cleanup": []
    },
    {
      "id": "t28-text-url-assertion",
      "title": "Text and URL assertion",
      "requires": [{ "tool": "browser_assert" }],
      "calls": [
        { "tool": "browser_navigate", "args": { "url": "{{origin}}/tasks/main.html" } },
        { "tool": "browser_assert", "args": { "kind": "text", "target": "h1", "expected": "Hand Tasks Main" } },
        { "tool": "browser_assert", "args": { "kind": "url", "expected": "{{origin}}/tasks/main.html" } }
      ],
      "expect": { "all": [
        { "call": 1, "path": "payload.verdict", "op": "eq", "value": true },
        { "call": 2, "path": "payload.verdict", "op": "eq", "value": true }
      ] },
      "cleanup": []
    },
    {
      "id": "t29-viewport-audit",
      "title": "Viewport audit, contrast and focus",
