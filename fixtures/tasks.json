        { "tool": "browser_navigate", "args": { "url": "{{origin}}/tasks/viewport.html" } },
        { "tool": "browser_audit", "args": { "viewports": [360, 390, 768, 1024, 1440, 2560], "checks": ["overflow", "contrast", "focus", "targetSize"] } }
      ],
      "expect": { "all": [
        { "call": 1, "path": "payload.viewports.length", "op": "eq", "value": 6 },
        { "call": 1, "path": "payload.verdict", "op": "eq", "value": "pass" }
